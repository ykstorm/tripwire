{
  "name": "@ykstormsorg/tripwire",
  "version": "1.0.1",
  "description": "LLM response guardrails — real-time streaming safety + post-hoc audit for AI chatbots",
  "license": "Apache-2.0",
  "repository": "github:ykstorm/tripwire",
  "homepage": "https://github.com/ykstorm/tripwire",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "keywords": [
    "llm",
    "safety",
    "guardrails",
    "streaming",
    "openai",
    "anthropic",
    "ai",
    "moderation"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "daemon": "node dist/daemon.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
